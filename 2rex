#!/usr/bin/env python3
"""Move terminal workspaces into rex.

usage: 2rex SOURCE [options]    see 2rex SOURCE --help
sources: herdr
"""
import importlib
import sys

from rex_common import Error

SOURCES = ("herdr",)


def main(argv):
    if not argv or argv[0] not in SOURCES:
        print(__doc__.strip(), file=sys.stderr)
        return 0 if argv[:1] in (["-h"], ["--help"]) else 2
    importlib.import_module(f"sources.{argv[0]}").main(argv[1:])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (Error, OSError, ValueError, KeyError, TypeError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)
